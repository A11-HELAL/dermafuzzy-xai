{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FISCalibrationSchema",
  "description": "Schema for DermaFuzzy-XAI Mamdani FIS Calibration Artifacts",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "n_samples",
    "feature_names",
    "cutoffs",
    "config_hash"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "n_samples": {
      "type": "integer",
      "minimum": 4
    },
    "feature_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "cutoffs": {
      "type": "object",
      "required": ["A", "B_fuzzy", "C", "D_verified"],
      "properties": {
        "A": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "minItems": 3,
          "maxItems": 3
        },
        "B_fuzzy": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "minItems": 3,
          "maxItems": 3
        },
        "C": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "minItems": 3,
          "maxItems": 3
        },
        "D_verified": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
